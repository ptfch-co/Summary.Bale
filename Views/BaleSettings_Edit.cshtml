@model Summary.Bale.BaleSettings

<div class="row">
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="ApiAccessKey">
      <label asp-for="ApiAccessKey">
        توکن وب سرویس(API)
      </label>
      <input type="text" asp-for="ApiAccessKey" class="form-control" />
      <span class="hint">
        جهت ارسال پیغام تبلیغاتی از طریق پیام رسان بله مقداردهی این فیلد الزامی است. در این فیلد توکن وب سرویس درج می‌گردد. مثال:
        SXvbFhxeNXvPRq
      </span>
    </div>
    <div class="form-group" asp-validation-class-for="Bot_Id">
      <label asp-for="Bot_Id">
        شناسه بازو(بات)
      </label>
      <input type="number" asp-for="Bot_Id" class="form-control" />
      <span class="hint">
        از طریق این فیلد مشخص کنید پیغام تبلیغاتی از طریق چه باتی به دست مخاطب برسد. مثال: 1360421000
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="Token">
        توکن بازو<span class="text-danger">*</span>
      </label>
      <input type="text" asp-for="Token" class="form-control" />
      <span class="hint">
        اگر قصد دارید پیغام‌ها را از طریق بات برای پروفایل مخاطبان، گروه یا کانال‌ها ارسال کنید مقداردهی این فیلد الزامی خواهد بود. مثال: g6xIS8Tk6gSLak8P7mX0AdmshS3yZX0CzA
      </span>
    </div>
  </div>
</div>